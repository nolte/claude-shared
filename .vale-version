# The one committed source for the Vale binary (#768): .github/workflows/ci.yml,
# .github/workflows/pr-lint.yml, and `task install:vale` read it through
# scripts/install_vale.sh, and `task lint:prose` compares the local binary to it.
# Renovate bumps VALE_VERSION (custom manager in renovate.json5) but can't
# recompute the checksum, so a bump PR stays red until VALE_SHA256 is replaced
# with the Linux_64-bit line of the release's vale_<version>_checksums.txt:
# tests/test_vale_version.py fails while the file name in that line names
# another version, and the install fails closed on a checksum mismatch.
VALE_VERSION=3.29.0
VALE_SHA256=00356ae1bacd1160aa415664f3ed0d34ce9ef5319c61d31123a97366ea1a2f64  vale_3.29.0_Linux_64-bit.tar.gz
