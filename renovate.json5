{
  extends: [
    'github>nolte/gh-plumbing//renovate-configs/common#v2.3.1',
  ],
  // spec/project/continuous-integration/ §C: CI installs from lock files that
  // `uv pip compile` generates from the requirement manifests; the pip-compile
  // manager reads each lock file's header to re-run that command on a bump.
  'pip-compile': {
    managerFilePatterns: ['/(^|/)requirements(-dev)?\\.lock\\.txt$/'],
  },
  packageRules: [
    // The default pip_requirements manager also matches the lock files and
    // their source manifests. Left on, it bumps a pin inside a lock without
    // re-running `uv pip compile`, or bumps a manifest the lock doesn't follow.
    // pip-compile owns both; pip_requirements keeps the unlocked manifests
    // (requirements.txt, evals/requirements-eval.txt, spec templates).
    {
      matchManagers: ['pip_requirements'],
      matchFileNames: [
        'requirements-dev.txt',
        'docs/requirements.txt',
        'evals/requirements-dev.txt',
        '**/*.lock.txt',
      ],
      enabled: false,
    },
    // spec/project/workflow-health/ MUST NOTs Renovate automerge for
    // nolte/gh-plumbing tag bumps: a human acknowledgement of each plumbing
    // bump is the portfolio-wide rollback signal (2026-Q3 audit finding
    // workflow-health.renovate-automerges-gh-plumbing; PR #392 merged 4
    // minutes after creation via the bot). automerge is disabled and the
    // label set is overridden so the shared preset's `automerge` label never
    // lands on these PRs. Note: the Mend app runs mode:silent for this repo,
    // so gh-plumbing PRs surface via the dashboard/portal and now wait for a
    // maintainer merge.
    {
      matchPackageNames: ['nolte/gh-plumbing'],
      automerge: false,
      labels: ['dependencies'],
    },
    // A Vale binary bump needs the manual VALE_SHA256 update in .vale-version
    // (#768, see customManagers below), so it never merges on its own.
    {
      matchPackageNames: ['vale-cli/vale'],
      automerge: false,
    },
  ],
  // spec/project/continuous-integration/ §C: the Vale toolchain is pinned to
  // content (#768), and these managers keep the pins current. The gh-plumbing
  // common preset already bumps nolte/vale-style in .vale.ini, so the managers
  // here match only the Microsoft and RedHat package URLs; a second match on
  // the same URL would propose the same bump twice.
  customManagers: [
    {
      customType: 'regex',
      description: 'Bump the Microsoft and RedHat Vale style packages pinned by release URL in .vale.ini.',
      managerFilePatterns: ['/(^|/)\\.vale\\.ini$/'],
      matchStrings: [
        'https://github\\.com/(?<depName>vale-cli/Microsoft)/releases/download/(?<currentValue>v[0-9.]+)/Microsoft\\.zip',
        'https://github\\.com/(?<depName>redhat-documentation/vale-at-red-hat)/releases/download/(?<currentValue>v[0-9]+)/RedHat\\.zip',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      // Renovate can't recompute VALE_SHA256, so the bump PR stays red
      // (tests/test_vale_version.py, and the checksum check in
      // scripts/install_vale.sh) until the Linux_64-bit line of the new
      // release's vale_<version>_checksums.txt replaces VALE_SHA256; the
      // packageRules entry for vale-cli/vale keeps it off automerge.
      customType: 'regex',
      description: 'Bump the Vale binary pinned in .vale-version.',
      managerFilePatterns: ['/(^|/)\\.vale-version$/'],
      matchStrings: ['VALE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'],
      depNameTemplate: 'vale-cli/vale',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
  ],
}
