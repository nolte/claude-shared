# Claude Code — local / user-specific
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Eval-harness run output (scorecards from live RUN_EVALS=1 runs)
/evals/out/

# Virtual environments
.venv/
venv/
env/
.python-version

# MkDocs build output
/site/

# License SBOM (generated by `task license:sbom`, reproducible from the manifests)
sbom.cdx.json
.sbom-venv/


# Task runner cache
.task/

# Spec-drift audits — quarterly artifacts are local-only; findings convert to issues/PRs
.audits/2026-Q*/
.audits/202[0-9]-Q[1-4]/

# Resume scratch — in-flight skill/agent state per spec/claude/resumable-work/ (local-only)
/.resume/

# Vale — style packages fetched by `vale sync` (keep repo-local vocab)
.github/styles/*
!.github/styles/config/
.github/styles/config/vocabularies/*
!.github/styles/config/vocabularies/claude-shared/

# Environment
.env
.env.*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Generated brand/mascot image renders — reproducible from design/prompts/*.md.
# Kept out of git on purpose; the .meta.json sidecars also embed the Cloudflare account id.
design/assets/
design/**/*.jpg
design/**/*.jpeg
design/**/*.png
design/**/*.meta.json
