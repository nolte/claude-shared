# Claude Code — local / user-specific
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/
.python-version

# MkDocs build output
/site/

# Generated skill and agent catalog (see scripts/docs/gen_catalog.py).
# Per spec/claude/skill-agent-catalog/: MUST NOT commit generated catalog markdown.
/docs/de/skills/
/docs/de/agents/
/docs/en/skills/
/docs/en/agents/
/docs/de/tags.md
/docs/en/tags.md

# Task runner cache
.task/

# Spec-drift audits — quarterly artifacts are local-only; findings convert to issues/PRs
.audits/2026-Q*/
.audits/202[0-9]-Q[1-4]/

# Vale — style packages fetched by `vale sync` (keep repo-local vocab)
.github/styles/*
!.github/styles/config/
.github/styles/config/vocabularies/*
!.github/styles/config/vocabularies/claude-shared/

# Environment
.env
.env.*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
