{
  "permissions": {
    "allow": [
      "Bash(task lint)",
      "Bash(task test)",
      "Bash(task docs)",
      "Bash(vale *)",
      "Bash(gh label list)",
      "Bash(gh label list *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(git rev-list *)",
      "Bash(git ls-remote *)",
      "Bash(git check-ignore *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard_feature_branch_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/wip_journal.py\" --session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/wip_journal.py\" --compact"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/wip_journal.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/validate_edited_artifact.py\""
          }
        ]
      }
    ]
  }
}
