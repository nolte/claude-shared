{
  "permissions": {
    "allow": [
      "Bash(task lint)",
      "Bash(task test)",
      "Bash(task docs)",
      "Bash(vale *)",
      "Bash(gh label list)",
      "Bash(gh label list *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(git rev-list *)",
      "Bash(git ls-remote *)",
      "Bash(git check-ignore *)",
      "mcp__github__get_me",
      "mcp__github__list_repository_collaborators",
      "mcp__github__list_issues",
      "mcp__github__issue_read",
      "mcp__github__search_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__search_pull_requests",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_file_contents",
      "mcp__github__list_releases",
      "mcp__github__get_latest_release",
      "mcp__github__get_release_by_tag",
      "mcp__github__list_discussions",
      "mcp__github__get_discussion_comments",
      "mcp__github__list_discussion_categories"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard_feature_branch_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/wip_journal.py\" --session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/wip_journal.py\" --compact"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/wip_journal.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/validate_edited_artifact.py\""
          }
        ]
      }
    ]
  }
}
